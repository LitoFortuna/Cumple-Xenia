      <!-- Enlaces Desktop -->
      <nav class="hidden md:flex items-center gap-7 text-xs font-normal text-[#a1a1a6]" aria-label="Principal">
        <button type="button" onclick="switchView('main', 'cronica')" class="hover:text-white transition cursor-pointer">Historia</button>
        <button type="button" onclick="switchView('main', 'detalles')" class="hover:text-white transition cursor-pointer">Detalles</button>
        <button type="button" onclick="switchView('main', 'dresscode')" class="hover:text-white transition cursor-pointer">Dress Code</button>
