<!DOCTYPE html>
<html lang="es" class="dark scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Órbita-X — Gala Estelar del Ritmo 3027</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --apple-black: #000000;
      --apple-surface: #121215;
      --apple-surface-hover: #18181d;
      --apple-text: #f5f5f7;
      --apple-muted: #86868b;
      --electric-blue: #0071e3;
      --electric-blue-bright: #2997ff;
      --royal-purple: #662483;
      --vibrant-purple: #a855f7;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Inter", sans-serif;
      background-color: var(--apple-black);
      color: var(--apple-text);
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
    }

    /* Barra superior translúcida estilo Apple */
    .apple-nav {
      background: rgba(12, 12, 15, 0.72);
      backdrop-filter: saturate(180%) blur(22px);
      -webkit-backdrop-filter: saturate(180%) blur(22px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    /* Tarjetas Bento */
    .bento-card {
      background: linear-gradient(180deg, rgba(24, 24, 29, 0.88) 0%, rgba(16, 16, 20, 0.94) 100%);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 28px;
      transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.35s ease, box-shadow 0.45s ease;
    }
    .bento-card:hover {
      border-color: rgba(255, 255, 255, 0.16);
      transform: translateY(-2px);
    }

    /* Degradados tipográficos Apple Keynote */
    .text-gradient-orbital {
      background: linear-gradient(135deg, #ffffff 10%, #7dd3fc 52%, #c084fc 95%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .text-gradient-blue {
      background: linear-gradient(135deg, #60a5fa 0%, #2997ff 55%, #a855f7 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Eclipse / Horizonte planetario minimalista estilo iPhone Pro */
    .apple-eclipse {
      position: relative;
      background: radial-gradient(
        68% 95% at 50% 108%,
        #000000 0%,
        #050712 46%,
        rgba(102, 36, 131, 0.72) 66%,
        rgba(0, 113, 227, 0.92) 76%,
        rgba(147, 197, 253, 0.95) 79%,
        rgba(41, 151, 255, 0.28) 84%,
        rgba(168, 85, 247, 0.14) 91%,
        transparent 100%
      );
    }

    /* Segmented Control estilo iOS */
    .ios-segment {
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 9999px;
      padding: 4px;
    }

    /* Inputs limpios estilo macOS / iOS */
    .apple-input {
      background: rgba(255, 255, 255, 0.045);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #f5f5f7;
      border-radius: 16px;
      transition: all 0.2s ease;
    }
    .apple-input:hover {
      border-color: rgba(255, 255, 255, 0.22);
    }
    .apple-input:focus {
      outline: none;
      background: rgba(255, 255, 255, 0.065);
      border-color: var(--electric-blue-bright);
      box-shadow: 0 0 0 4px rgba(41, 151, 255, 0.18);
    }
    select option {
      background-color: #121215;
      color: #f5f5f7;
    }

    /* Botón primario Apple */
    .btn-apple-primary {
      background: var(--electric-blue);
      color: #ffffff;
      border-radius: 9999px;
      transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.25s ease;
    }
    .btn-apple-primary:hover {
      background: #0077ed;
      box-shadow: 0 10px 30px rgba(0, 113, 227, 0.35);
    }
    .btn-apple-primary:active {
      transform: scale(0.98);
    }

    .btn-apple-purple {
      background: linear-gradient(135deg, #662483 0%, #7c3aed 55%, #0071e3 100%);
      color: #ffffff;
      border-radius: 9999px;
      transition: opacity 0.2s ease, transform 0.2s ease, box-shadow 0.25s ease;
    }
    .btn-apple-purple:hover {
      opacity: 0.94;
      box-shadow: 0 10px 32px rgba(124, 58, 237, 0.38);
    }
    .btn-apple-purple:active {
      transform: scale(0.98);
    }

    /* Animaciones suaves de entrada al hacer scroll */
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    @keyframes slow-pulse {
      0%, 100% { opacity: 0.55; transform: scale(1); }
      50% { opacity: 0.9; transform: scale(1.06); }
    }
    .ambient-orb {
      animation: slow-pulse 8s ease-in-out infinite;
    }
  </style>
</head>
<body class="selection:bg-[#0071e3] selection:text-white">

  <!-- Barra de Navegación Minimalista estilo Apple -->
  <header class="apple-nav sticky top-0 z-50">
    <div class="max-w-5xl mx-auto px-5 h-14 flex items-center justify-between gap-4">
