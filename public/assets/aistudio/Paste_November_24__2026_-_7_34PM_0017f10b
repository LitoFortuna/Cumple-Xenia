        <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-[#662483] via-[#a855f7] to-[#2997ff] flex items-center justify-center shadow-[0_0_16px_rgba(41,151,255,0.45)]">
          <span class="w-2 h-2 rounded-full bg-black"></span>
        </span>
