  <script>
    const WEB3FORMS_KEY = "30ff5d7e-c034-41c5-9fe6-2d233bf95a21";

    // --- Scroll Reveal estilo Apple ---
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    }, { threshold: 0.12 });

    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

    // --- Navegación entre vistas ---
    function switchView(view, sectionId = 'top') {
      const viewMain = document.getElementById('view-main');
      const viewRumors = document.getElementById('view-rumors');
      const segMain = document.getElementById('seg-main');
      const segRumors = document.getElementById('seg-rumors');

      const activeSeg = ['bg-white', 'text-black', 'shadow-sm'];
      const inactiveSeg = ['text-[#a1a1a6]', 'hover:text-white'];

      if (view === 'rumors') {
        viewMain.classList.add('hidden');
        viewRumors.classList.remove('hidden');
        segRumors.classList.add(...activeSeg);
        segRumors.classList.remove(...inactiveSeg);
        segMain.classList.remove(...activeSeg);
        segMain.classList.add(...inactiveSeg);
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        viewRumors.classList.add('hidden');
        viewMain.classList.remove('hidden');
        segMain.classList.add(...activeSeg);
        segMain.classList.remove(...inactiveSeg);
        segRumors.classList.remove(...activeSeg);
        segRumors.classList.add(...inactiveSeg);

        if (sectionId === 'top') {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          const target = document.getElementById(sectionId);
          if (target) {
            const yOffset = -110;
            const y = target.getBoundingClientRect().top + window.scrollY + yOffset;
            window.scrollTo({ top: y, behavior: 'smooth' });
          }
        }
      }
    }

    function goToRumorsFromSuccess() {
      const guestName = document.getElementById('rsvp-nombre').value.trim();
      if (guestName && !document.getElementById('rumor-autor').value) {
        document.getElementById('rumor-autor').value = guestName;
      }
      switchView('rumors');
    }

    // --- Envío a Web3Forms ---
    async function sendToWeb3Forms(formData) {
      if (!WEB3FORMS_KEY.trim()) {
        throw new Error("Falta configurar la Access Key de Web3Forms.");
      }
      formData.append("access_key", WEB3FORMS_KEY);
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: formData
      });
      const result = await response.json();
      if (!result.success) {
        throw new Error(result.message || "Error al enviar los datos.");
      }
      return result;
    }

    // --- Formulario 1: Personaje ---
    const rsvpForm = document.getElementById('rsvp-form');
    const rsvpBtn = document.getElementById('rsvp-submit-btn');
    const rsvpSuccess = document.getElementById('rsvp-success-box');
    const rsvpError = document.getElementById('rsvp-error-msg');

    rsvpForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      rsvpError.classList.add('hidden');

      const originalText = rsvpBtn.textContent;
      rsvpBtn.disabled = true;
      rsvpBtn.textContent = "Transmitiendo registro…";

      const formData = new FormData(rsvpForm);
      const nombre = formData.get('Nombre');
      formData.append("subject", `🚀 Personaje Órbita-X: ${nombre}`);
      formData.append("from_name", "Gala Estelar Órbita-X");

      try {
        await sendToWeb3Forms(formData);
        document.getElementById('guest-name-display').textContent = nombre;
        rsvpForm.classList.add('hidden');
        rsvpSuccess.classList.remove('hidden');
      } catch (err) {
        rsvpError.textContent = "⚠️ " + err.message;
        rsvpError.classList.remove('hidden');
        rsvpBtn.disabled = false;
        rsvpBtn.textContent = originalText;
      }
    });

    // --- Formulario 2: Buzón de Lady Nebula ---
    const rumorForm = document.getElementById('rumor-form');
    const rumorBtn = document.getElementById('rumor-submit-btn');
    const rumorSuccess = document.getElementById('rumor-success-box');
    const rumorError = document.getElementById('rumor-error-msg');

    rumorForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      rumorError.classList.add('hidden');

      const originalText = rumorBtn.textContent;
      rumorBtn.disabled = true;
      rumorBtn.textContent = "Enviando soplo a Lady Nebula…";

      const formData = new FormData(rumorForm);
      const objetivo = formData.get('Invitado_Objetivo');
      const autor = formData.get('Informante_Secreto')?.trim() || "Anónimo";
      formData.set('Informante_Secreto', autor);
      formData.append("subject", `👁️ Rumor Lady Nebula sobre ${objetivo} (por ${autor})`);
      formData.append("from_name", "Buzón de Lady Nebula");

      try {
        await sendToWeb3Forms(formData);
        document.getElementById('rumor-target-display').textContent = objetivo;
        rumorForm.classList.add('hidden');
        rumorSuccess.classList.remove('hidden');
      } catch (err) {
        rumorError.textContent = "⚠️ " + err.message;
        rumorError.classList.remove('hidden');
      } finally {
        rumorBtn.disabled = false;
        rumorBtn.textContent = originalText;
      }
    });

    function resetRumorForm() {
      const savedAuthor = document.getElementById('rumor-autor').value;
      rumorForm.reset();
      document.getElementById('rumor-autor').value = savedAuthor;
      rumorSuccess.classList.add('hidden');
      rumorForm.classList.remove('hidden');
    }
  </script>
